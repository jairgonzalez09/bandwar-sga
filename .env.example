# ==============================================================================
# ARCHIVO DE CONFIGURACIÓN DE EJEMPLO (.env.example)
# Proyecto: Métodos Tácticos de Resistencia Revolucionaria (MTRR)
# ==============================================================================

# Puerto local en el que el servidor escuchará las peticiones del Operador de Terreno
PORT=3000

# Entorno de ejecución del sistema (development, production)
NODE_ENV=development

# ------------------------------------------------------------------------------
# CONFIGURACIÓN DE LA BASE DE DATOS (PostgreSQL)
# ------------------------------------------------------------------------------
# Formato sugerido: postgresql://usuario:contraseña@servidor:puerto/nombre_db
DATABASE_URL=postgresql://postgres:tu_contrasena_local@127.0.0.1:5432/mtrr_unefa_db

# (Opcional) Si tu ORM/Sequelize requiere los campos por separado:
DB_USER=postgres
DB_PASSWORD=tu_contrasena_local
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=simulacion_db

# ------------------------------------------------------------------------------
# AUTENTICACIÓN Y SEGURIDAD (JWT)
# ------------------------------------------------------------------------------
# Clave secreta utilizada por el backend para firmar y validar los tokens de acceso del Cliente
JWT_SECRET=firma_secreta_de_desarrollo_unefa_mtrr_2026

# Tiempo de expiración configurado para la sesión del Operador de Terreno (ej: 24h, 7d)
JWT_EXPIRES_IN=24h